{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-project",
              "--quiet",
              "python",
              "${CLAUDE_PLUGIN_ROOT}/bin/talkback.py",
              "hook",
              "stop"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-project",
              "--quiet",
              "python",
              "${CLAUDE_PLUGIN_ROOT}/bin/talkback.py",
              "hook",
              "prompt"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-project",
              "--quiet",
              "python",
              "${CLAUDE_PLUGIN_ROOT}/bin/talkback.py",
              "hook",
              "session-start"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-project",
              "--quiet",
              "python",
              "${CLAUDE_PLUGIN_ROOT}/bin/talkback.py",
              "hook",
              "session-end"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
